{
  "$schema": "./cloudflare/node_modules/wrangler/config-schema.json",
  "name": "morning-paper",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT",
        "class_name": "BriefAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BriefAgent"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "PI",
      "service": "morning-paper-pi",
      "entrypoint": "PiService"
    },
    {
      "binding": "INTEGRATIONS",
      "service": "morning-paper-credentials",
      "entrypoint": "IntegrationWrites"
    }
  ]
}
