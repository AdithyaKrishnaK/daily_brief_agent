{
  "name": "morning-paper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "brief:today": "node scripts/brief-today.mjs",
    "brief:render": "node scripts/brief-today.mjs --render-only",
    "brief:view": "node scripts/brief-today.mjs --render-only --serve",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test:e2e": "playwright test",
    "deploy:check": "npm run build && npm --prefix cloudflare run deploy:check",
    "dev:worker": "npm --prefix cloudflare run dev",
    "typecheck:worker": "npm --prefix cloudflare run typecheck"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-durable": "1.0.0",
    "fast-xml-parser": "5.7.3",
    "jose": "6.2.12",
    "parse5": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.9"
  }
}
